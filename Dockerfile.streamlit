# 深度研究助手（Streamlit）
# 与 Dockerfile（FastAPI 版）并存，互不影响。
#
# 本地构建：docker build -f Dockerfile.streamlit -t research-assistant .
# 本地运行：docker run --rm -p 8501:8501 --env-file .env research-assistant
# 访问：    http://localhost:8501

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 先只复制依赖清单，让这一层能被缓存
COPY requirements-streamlit.txt .
RUN pip install --no-cache-dir -r requirements-streamlit.txt \
        -i https://pypi.tuna.tsinghua.edu.cn/simple

# 再复制代码（.dockerignore 已排除 .env / .venv / chroma_db）
COPY . .

EXPOSE 8501

# 用 shell 形式，才能展开 Railway 注入的 $PORT；本地没这个变量时退回 8501
CMD streamlit run project4_research_app.py \
    --server.port=${PORT:-8501} \
    --server.address=0.0.0.0 \
    --server.headless=true \
    --browser.gatherUsageStats=false
